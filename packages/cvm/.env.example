# === Offsite backup target ===
# S3-compatible (AWS S3, Cloudflare R2, Backblaze B2, MinIO). Leave
# CVM_S3_BUCKET empty to keep backups local-only (current default; backup.py
# also no-ops the local snapshot when no bucket is set so the volume stays
# clean during a backfill).
CVM_S3_BUCKET=
CVM_S3_PREFIX=cvm-backups
CVM_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS S3:        us-east-1 (or your region)
# Cloudflare R2: auto
# Backblaze B2:  us-west-001 (or whichever your bucket lives in)
AWS_DEFAULT_REGION=us-east-1

# Cloudflare R2 example (free tier: 10 GB-month storage, $0 egress):
#   1) Create bucket on dash.cloudflare.com -> R2
#   2) "Manage R2 API Tokens" -> create token with Object Read & Write on the bucket
#   3) Endpoint URL is shown on the bucket page as
#        https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# CVM_S3_BUCKET=cvm-backups
# CVM_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=<R2 access key id>
# AWS_SECRET_ACCESS_KEY=<R2 secret access key>
# AWS_DEFAULT_REGION=auto

# How many timestamped snapshots to retain (older ones are rotated out). On a
# 10 GB free tier with a ~5 GB DB, keep this small or you'll run over.
CVM_BACKUP_KEEP=2

# Live prices (B3) for price-based ratios.
BRAPI_API_KEY=

# Scheduler (UTC). Optional overrides.
CVM_DAILY_HOUR=9
CVM_WEEKLY_FULL_DOW=sun
CVM_WEEKLY_FULL_HOUR=4
CVM_BACKUP_HOUR=3
