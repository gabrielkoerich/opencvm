# Offsite backup target (S3 / R2 / MinIO). Leave CVM_S3_BUCKET empty to disable.
CVM_S3_BUCKET=
CVM_S3_PREFIX=cvm-backups
CVM_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Live prices (B3) for price-based ratios.
BRAPI_API_KEY=

# Scheduler (UTC). Optional overrides.
CVM_DAILY_HOUR=9
CVM_WEEKLY_FULL_DOW=sun
CVM_WEEKLY_FULL_HOUR=4
CVM_BACKUP_HOUR=3
