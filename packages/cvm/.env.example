# === Continuous backup: Litestream → R2 ===
# Litestream tails the SQLite WAL and ships every frame to S3-compatible storage
# (we recommend Cloudflare R2 — 10 GB free, $0 egress). On a cold-boot box,
# litestream-restore pulls the latest replica before the api/worker start.
#
# Cloudflare R2 setup:
#   1) dash.cloudflare.com -> R2 -> Create bucket (e.g. "opencvm-backups")
#   2) Manage R2 API Tokens -> create token with "Object Read & Write" on the bucket
#   3) Copy the S3 endpoint shown on the bucket page:
#        https://<ACCOUNT_ID>.r2.cloudflarestorage.com
LITESTREAM_BUCKET=
LITESTREAM_PREFIX=opencvm
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Local backup rotation (kept for the manual `python -m cvm backup --no-s3` path).
CVM_BACKUP_KEEP=2

# Live prices (B3) for price-based ratios.
BRAPI_API_KEY=

# Global API rate limit (per-IP). slowapi syntax: "<n>/<window>" — e.g.
# 60/minute, 1000/hour, 10/second. Backed by Redis so all api replicas share it.
CVM_RATE_LIMIT=60/minute

# CORS — comma-separated allowed origins, or "*" for fully open.
CVM_CORS_ORIGINS=*

# Scheduler (UTC). Optional overrides.
CVM_DAILY_HOUR=9
CVM_WEEKLY_FULL_DOW=sun
CVM_WEEKLY_FULL_HOUR=4
